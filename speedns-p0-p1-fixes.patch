+// protocolOrder ranks a protocol by its position in catalog.AllProtocols so
+// the measured order matches the documented and displayed order.
+func protocolOrder(protocol catalog.Protocol) int {
+	for index, candidate := range catalog.AllProtocols {
+		if candidate == protocol {
+			return index
+		}
+	}
+	return len(catalog.AllProtocols)
+}
